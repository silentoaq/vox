#pragma code_page(65001)
#include <winver.h>

#include "version.h"

1 ICON "../res/vox.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VOX_VERSION_NUMBERS
PRODUCTVERSION VOX_VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040404B0"
    BEGIN
      VALUE "FileDescription", "Vox 伴唱分離"
      VALUE "ProductName", "Vox"
      VALUE "FileVersion", VOX_VERSION_STRING
      VALUE "ProductVersion", VOX_VERSION_STRING
      VALUE "OriginalFilename", "vox-separate.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0404, 1200
  END
END
